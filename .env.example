# Required security config
APP_JWT_SECRET=replace-with-at-least-32-chars

# External MySQL (reachable from the backend container)
DB_URL=jdbc:mysql://10.0.0.10:3306/docbridge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=REQUIRED
DB_USERNAME=docbridge
DB_PASSWORD=replace-with-a-strong-database-password

# Tencent OCR
APP_OCR_TENCENT_SECRET_ID=
APP_OCR_TENCENT_SECRET_KEY=
APP_OCR_TENCENT_REGION=ap-beijing

# Tencent Translate
APP_TRANSLATE_TENCENT_SECRET_ID=
APP_TRANSLATE_TENCENT_SECRET_KEY=
APP_TRANSLATE_TENCENT_REGION=ap-beijing
APP_TRANSLATE_TENCENT_PROJECT_ID=0

# Production authentication (configure a real WeChat Open Platform app)
APP_WECHAT_APP_ID=
APP_WECHAT_APP_SECRET=
APP_WECHAT_REDIRECT_URI=https://your-domain.example/api/v1/auth/wechat/callback
APP_WECHAT_FRONTEND_ORIGIN=https://your-domain.example

# Optional
APP_FREE_TOTAL=1000
